# Required – use same values as apps/web (SUPABASE_URL = NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional – for single-URL Easy Apply (browser-use agent)
# GEMINI_API_KEY=your-gemini-key
# OPENAI_API_KEY=your-openai-key

# Optional
# HEADLESS=true
# POLL_INTERVAL_MS=15000

# VPN / firewall: use a proxy that can reach the internet (e.g. your company proxy or a tunnel)
# HTTPS_PROXY=http://proxy-host:port
# HTTP_PROXY=http://proxy-host:port

# If DNS fails over VPN, try IPv4 first (run: node --dns-result-order=ipv4first ./node_modules/tsx/dist/cli.mjs watch src/index.ts)
# Or set in PowerShell before npm run dev: $env:NODE_OPTIONS="--dns-result-order=ipv4first"
