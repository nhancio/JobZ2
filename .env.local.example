# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (from dashboard: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Worker only: service role key (bypasses RLS). Keep secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (AI match scoring)
GEMINI_API_KEY=your-gemini-api-key

# Worker: browser-use agent uses OpenAI for LLM (required for automation)
OPENAI_API_KEY=your-openai-api-key

# Optional: encrypt LinkedIn session data (defaults to anon key if unset)
SESSION_ENCRYPTION_SECRET=optional-32-char-secret

# Worker optional
POLL_INTERVAL_MS=15000
HEADLESS=true
