# Web app (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Gemini for server-side features (e.g. future server-side scoring)
GEMINI_API_KEY=

# Worker (use in apps/worker/.env or export in shell)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GEMINI_API_KEY=your-gemini-key
# OPENAI_API_KEY=  (optional; if set, browser-use uses OpenAI. If unset and GEMINI_API_KEY set, worker uses Gemini via OpenAI-compatible API)
# POLL_INTERVAL_MS=15000
# HEADLESS=true
